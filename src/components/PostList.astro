---
import type { BlogPost } from '../utils/blog';
import { getReadingTime, getTagHref } from '../utils/blog';
import FormattedDate from './FormattedDate.astro';

interface Props { posts: BlogPost[]; emptyText?: string; }
const { posts, emptyText = '暂时还没有文章。' } = Astro.props;
---

{posts.length > 0 ? (
	<div class="post-list">
		{posts.map((post) => (
			<article class="post-item">
				<div class="post-meta">
					<FormattedDate date={post.data.pubDate} /><span aria-hidden="true">·</span>
					<span>{getReadingTime(post.body)} 分钟阅读</span>
					{post.data.draft && <span class="draft-badge">草稿</span>}
				</div>
				<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
				<p class="post-description">{post.data.description}</p>
				{post.data.tags.length > 0 && (
					<ul class="tag-list" aria-label="文章标签">
						{post.data.tags.map((tag) => <li><a href={getTagHref(tag)}>#{tag}</a></li>)}
					</ul>
				)}
			</article>
		))}
	</div>
) : <p class="empty-state">{emptyText}</p>}

<style>
	.post-list { border-top: 1px solid var(--border); }
	.post-item { padding: 2rem 0; border-bottom: 1px solid var(--border); }
	.post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; margin-bottom: 0.65rem; color: var(--text-subtle); font-size: 0.78rem; font-variant-numeric: tabular-nums; }
	.post-item h2 { margin: 0; font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.4; }
	.post-item h2 a { color: var(--text); text-decoration: none; text-decoration-thickness: 1px; text-underline-offset: 0.24em; }
	.post-item h2 a:hover { color: var(--accent-strong); text-decoration: underline; }
	.post-description { margin: 0.7rem 0 0; color: var(--text-muted); font-size: 0.94rem; line-height: 1.8; }
	.tag-list { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.8rem 0 0; padding: 0; list-style: none; }
	.tag-list a { color: var(--text-subtle); font-size: 0.78rem; text-decoration: none; }
	.tag-list a:hover { color: var(--accent); }
	.draft-badge { padding: 0.08rem 0.45rem; border: 1px solid var(--amber-border); border-radius: 999px; color: var(--amber-text); }
	.empty-state { padding: 3rem 0; color: var(--text-muted); }
</style>
