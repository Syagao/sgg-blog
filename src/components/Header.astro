---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<div class="header-inner">
		<a class="wordmark" href="/" aria-label={`${SITE_TITLE}首页`}>{SITE_TITLE}</a>
		<nav aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/archive/">归档</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</nav>
		<ThemeToggle />
	</div>
</header>

<style>
	.site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--background) 92%, transparent); }
	.header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(100% - 2.5rem, var(--site-width)); height: 4.5rem; margin-inline: auto; }
	.wordmark { width: max-content; color: var(--text); font-size: 1.05rem; font-weight: 700; letter-spacing: 0.08em; text-decoration: none; }
	nav { display: flex; align-items: center; gap: 1.6rem; }
	:global(.theme-toggle) { justify-self: end; }
	@media (max-width: 640px) {
		.header-inner { grid-template-columns: 1fr auto; width: min(100% - 1.5rem, var(--site-width)); height: auto; min-height: 4rem; }
		nav { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; gap: 0.4rem; width: 100%; padding: 0 0 0.65rem; }
		:global(.theme-toggle) { grid-column: 2; grid-row: 1; }
	}
</style>
