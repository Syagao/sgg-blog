---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import jiamoImage from '../../pic/jiamo.jpg';
import GitHubLink from './GitHubLink.astro';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<div class="header-inner">
		<a class="avatar-link" href="/">
			<Image
				class="brand-avatar"
				src={jiamoImage}
				alt="沈高高的头像"
				width={88}
				height={88}
				format="webp"
				quality={80}
				loading="eager"
				fetchpriority="high"
			/>
		</a>
		<a class="wordmark" href="/" aria-label={`${SITE_TITLE}首页`}>Shen Gao Gao</a>
		<nav aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/archive/" activePaths={['/blog/']}>归档</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</nav>
		<div class="header-actions">
			<GitHubLink />
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--background) 92%, transparent); }
	.header-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-rows: auto auto;
		align-items: center;
		column-gap: 1.125rem;
		row-gap: 0.2rem;
		width: min(100% - 2.5rem, var(--content-width));
		min-height: 8.5rem;
		margin-inline: auto;
		padding-block: 1.25rem;
	}

	.avatar-link {
		grid-column: 1;
		grid-row: 1 / 3;
		display: block;
		border-radius: 0.75rem;
		overflow: hidden;
	}

	.brand-avatar {
		width: 88px;
		height: 88px;
		object-fit: cover;
	}

	.wordmark {
		grid-column: 2;
		grid-row: 1;
		align-self: end;
		width: max-content;
		color: var(--text);
		font-family: Inter, sans-serif;
		font-size: 2.125rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.15;
		text-decoration: none;
	}

	nav {
		grid-column: 2;
		grid-row: 2;
		align-self: start;
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	nav :global(a + a) {
		border-left: 1px dashed var(--border-strong);
		padding-left: 1.25rem;
	}

	nav :global(a + a)::after { left: 1.25rem; }

	.header-actions {
		grid-column: 3;
		grid-row: 1 / 3;
		display: inline-flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.6rem;
		justify-self: end;
		width: max-content;
	}

	@media (max-width: 640px) {
		.header-inner {
			grid-template-columns: 3.5rem 1fr auto;
			grid-template-rows: auto auto;
			column-gap: 0.9rem;
			row-gap: 0.75rem;
			width: min(100% - 1.5rem, var(--content-width));
			min-height: 0;
			padding-block: 0.9rem 0.7rem;
		}

		.avatar-link { grid-row: 1; border-radius: 0.55rem; }
		.brand-avatar { width: 56px; height: 56px; }
		.wordmark { align-self: center; font-size: 1.5rem; }
		nav {
			grid-column: 1 / -1;
			grid-row: 2;
			justify-content: space-between;
			gap: 0.4rem;
			width: 100%;
		}
		nav :global(a + a) { border-left: 0; padding-left: 0; }
		nav :global(a + a)::after { left: 0; }
		.header-actions { grid-row: 1; }
	}
</style>
