---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	activePaths?: string[];
};

const { href, class: className, activePaths = [], ...props } = Astro.props;
const baseURL = import.meta.env.BASE_URL;
const pathname = baseURL === '/' ? Astro.url.pathname : Astro.url.pathname.replace(baseURL, '/');
const target = String(href);
const isActive = target === '/'
	? pathname === '/'
	: pathname.startsWith(target) || activePaths.some((path) => pathname.startsWith(path));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>

<style>
	a { position: relative; padding: 0.4rem 0; color: var(--text-muted); font-size: 1rem; text-decoration: none; transition: color 160ms ease; }
	a::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		border-radius: 999px;
		background: var(--nav-active);
		content: '';
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}
	a:hover, a:focus-visible { color: var(--nav-active); }
	a:hover::after, a:focus-visible::after { transform: scaleX(1); }
	a.active { color: var(--nav-active); }
</style>
