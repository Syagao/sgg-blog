---
import { GITHUB_URL, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p>© {year} {SITE_TITLE}</p>
		<div class="footer-links">
			<a href="/rss.xml">RSS</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
		</div>
	</div>
</footer>

<style>
	.site-footer { margin-top: 6rem; border-top: 1px solid var(--border); color: var(--text-subtle); }
	.footer-inner { display: flex; justify-content: space-between; width: min(100% - 2.5rem, var(--content-width)); margin-inline: auto; padding: 2rem 0 3.5rem; font-size: 0.82rem; }
	.footer-inner p { margin: 0; }
	.footer-links { display: flex; gap: 1.1rem; }
	.footer-links a { color: inherit; text-decoration: none; }
	.footer-links a:hover { color: var(--accent); }
</style>
