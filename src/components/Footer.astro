---
import { SITE_TITLE } from '../consts';
---

<footer class="site-footer">
	<div class="footer-inner">
		<a class="footer-signature" href="/" aria-label={`${SITE_TITLE}首页`}>{`@${SITE_TITLE}`}</a>
		<nav class="footer-nav" aria-label="页脚导航">
			<a href="/">首页</a>
			<a href="/archive/">归档</a>
			<a href="/about/">关于</a>
			<a href="/rss.xml" aria-label="RSS 订阅">RSS</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(4rem, 8vw, 6rem);
		color: var(--text-muted);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 2.5rem, var(--site-width));
		margin-inline: auto;
		padding: 2rem 0 2.5rem;
		font-size: 16px;
		font-weight: 600;
	}

	.footer-signature,
	.footer-nav a {
		color: inherit;
		text-decoration: none;
	}

	.footer-nav a {
		position: relative;
		padding: 0.35rem 0;
		transition: color 160ms ease;
	}

	.footer-nav a::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		border-radius: 999px;
		background: var(--nav-active);
		content: '';
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.footer-nav {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.footer-nav a + a {
		border-left: 1px solid var(--border-strong);
		padding-left: 1.25rem;
	}

	.footer-nav a + a::after { left: 1.25rem; }

	.footer-signature:hover { color: var(--accent); }
	.footer-nav a:hover,
	.footer-nav a:focus-visible { color: var(--nav-active); }
	.footer-nav a:hover::after,
	.footer-nav a:focus-visible::after { transform: scaleX(1); }

	@media (max-width: 640px) {
		.site-footer { margin-top: 3.5rem; }
		.footer-inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 1rem;
			width: min(100% - 1.5rem, var(--site-width));
			padding: 1.5rem 0 2rem;
			font-size: 15px;
		}
		.footer-nav { flex-wrap: wrap; gap: 0.7rem 1rem; }
		.footer-nav a + a { padding-left: 1rem; }
		.footer-nav a + a::after { left: 1rem; }
	}
</style>
