---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
import { formatDate, getPublishedPosts } from '../utils/blog';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 6);
const sections = [
	{ title: '数学基础', description: '机器人与控制中常用的数学、建模与推导。' },
	{ title: '运动控制', description: '记录控制理论、算法实现与现场调试经验。' },
	{ title: '大模型知识', description: '整理模型原理、工具使用与应用实践。' },
	{ title: '人形机器人', description: '关注感知、规划、控制与整机系统。' },
];
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="page-container home-page">
		<section class="home-sections" aria-labelledby="sections-title">
			<div class="section-heading">
				<h2 id="sections-title">版块</h2>
				<span class="section-rule" aria-hidden="true"></span>
			</div>

			<ul class="section-grid">
				{sections.map((section) => (
					<li class="section-card">
						<h3>{section.title}</h3>
						<p>{section.description}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="latest" aria-labelledby="latest-title">
			<div class="section-heading">
				<h2 id="latest-title">最新文章</h2>
				<span class="section-rule" aria-hidden="true"></span>
				<a href="/archive/">查看全部 <span aria-hidden="true">→</span></a>
			</div>

			{latestPosts.length > 0 ? (
				<ul class="home-post-list">
					{latestPosts.map((post) => (
						<li>
							<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							<a href={`/blog/${post.id}/`} class="home-post-title">{post.data.title}</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">暂时还没有文章。</p>
			)}
		</section>
	</div>
</PageLayout>

<style>
	.home-page { padding-top: clamp(3.5rem, 7vw, 5.5rem); }

	.home-sections { margin-bottom: clamp(4.5rem, 8vw, 6rem); }

	.section-heading {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		margin-bottom: 2.35rem;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--text);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.35;
		white-space: nowrap;
	}

	.section-rule {
		flex: 1;
		height: 1px;
		background: color-mix(in srgb, var(--nav-active) 12%, var(--border));
	}

	.section-heading a {
		color: var(--nav-active);
		font-size: 0.95rem;
		text-decoration: none;
		white-space: nowrap;
		transition: color 160ms ease;
	}

	.section-heading a:hover,
	.section-heading a:focus-visible { color: var(--text); }

	.section-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 1.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.section-card {
		min-height: 7.2rem;
		padding: 1.25rem 1.4rem;
		border: 1px solid color-mix(in srgb, var(--nav-active) 17%, var(--border));
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--nav-active) 2%, var(--background));
	}

	.section-card h3 {
		margin: 0;
		color: var(--text);
		font-size: 1.16rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.section-card p {
		margin: 0.48rem 0 0;
		color: var(--text-muted);
		font-size: 0.91rem;
		line-height: 1.7;
	}

	.home-post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-post-list li {
		display: grid;
		grid-template-columns: 9.2rem minmax(0, 1fr);
		gap: 1.2rem;
		align-items: baseline;
		padding: 0.62rem 0;
	}

	.home-post-list time {
		color: var(--text-muted);
		font-size: 1rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.home-post-title {
		color: var(--text);
		font-size: 1.04rem;
		line-height: 1.7;
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: color 160ms ease, text-decoration-color 160ms ease;
	}

	.home-post-title:hover,
	.home-post-title:focus-visible {
		color: var(--nav-active);
		text-decoration-color: var(--nav-active);
	}

	.empty-state { margin: 0; color: var(--text-muted); }

	@media (max-width: 640px) {
		.home-page { padding-top: 3.5rem; }
		.home-sections { margin-bottom: 4rem; }
		.section-heading { gap: 0.75rem; margin-bottom: 1.7rem; }
		.section-heading h2 { font-size: 1.3rem; }
		.section-heading a { font-size: 0.88rem; }
		.section-grid { grid-template-columns: 1fr; gap: 0.8rem; }
		.section-card { min-height: 0; padding: 1.1rem 1.15rem; }
		.home-post-list li { grid-template-columns: 1fr; gap: 0.12rem; padding: 0.68rem 0; }
		.home-post-list time { font-size: 0.88rem; }
		.home-post-title { font-size: 1rem; }
	}
</style>
