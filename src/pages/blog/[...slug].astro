---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPosts, getReadingTime } from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			previousPost: posts[index + 1] ? { id: posts[index + 1].id, title: posts[index + 1].data.title } : undefined,
			nextPost: posts[index - 1] ? { id: posts[index - 1].id, title: posts[index - 1].data.title } : undefined,
		},
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	previousPost?: { id: string; title: string };
	nextPost?: { id: string; title: string };
}

const { post, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost
	{...post.data}
	headings={headings}
	readingTime={getReadingTime(post.body)}
	{previousPost}
	{nextPost}
>
	<Content />
</BlogPost>
