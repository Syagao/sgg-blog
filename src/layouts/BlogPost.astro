---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { getTagHref } from '../utils/blog';
import PageLayout from './PageLayout.astro';

interface Heading { depth: number; slug: string; text: string; }
interface AdjacentPost { id: string; title: string; }
type PostData = CollectionEntry<'blog'>['data'];
interface Props extends PostData {
	headings?: Heading[];
	readingTime?: number;
	previousPost?: AdjacentPost;
	nextPost?: AdjacentPost;
}

const {
	title, description, pubDate, updatedDate, heroImage, tags,
	headings = [], readingTime = 1, previousPost, nextPost,
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const weiboURL = `https://service.weibo.com/share/share.php?url=${encodeURIComponent(pageURL)}&title=${encodeURIComponent(title)}`;
const emailURL = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(pageURL)}`;
---

<PageLayout title={title} description={description} image={heroImage} type="article" mainClass="post-main">
	<div class="post-grid">
		<article class="post-article">
			<header class="post-header">
				<a class="back-link" href="/blog/">← 返回文章列表</a>
				<h1>{title}</h1>
				<p class="post-lead">{description}</p>
				<div class="post-meta">
					<span>发布于 <FormattedDate date={pubDate} /></span>
					{updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
					<span>{readingTime} 分钟阅读</span>
				</div>
				{tags.length > 0 && (
					<ul class="post-tags" aria-label="文章标签">
						{tags.map((tag) => <li><a href={getTagHref(tag)}>#{tag}</a></li>)}
					</ul>
				)}
			</header>

			{heroImage && (
				<figure class="hero-image">
					<Image src={heroImage} widths={[640, 960, 1280]} sizes="(max-width: 780px) 100vw, 780px" alt="" loading="eager" />
				</figure>
			)}

			<div class="article-content" data-article-content><slot /></div>

			<footer class="post-footer">
				<section class="share-row" aria-label="分享文章">
					<span>分享文章</span>
					<button class="copy-link" type="button" data-url={pageURL}>复制链接</button>
					<a href={weiboURL} target="_blank" rel="noreferrer">微博</a>
					<a href={emailURL}>邮件</a>
				</section>

				<nav class="post-navigation" aria-label="文章翻页">
					{previousPost ? (
						<a class="previous" href={`/blog/${previousPost.id}/`}><span>上一篇</span><strong>{previousPost.title}</strong></a>
					) : <span />}
					{nextPost && (
						<a class="next" href={`/blog/${nextPost.id}/`}><span>下一篇</span><strong>{nextPost.title}</strong></a>
					)}
				</nav>
			</footer>
		</article>

		{tocHeadings.length > 0 && (
			<aside class="toc" aria-label="文章目录">
				<p>目录</p>
				<nav>
					{tocHeadings.map((heading) => (
						<a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
					))}
				</nav>
			</aside>
		)}
	</div>
</PageLayout>

<script>
	const article = document.querySelector<HTMLElement>('[data-article-content]');

	article?.querySelectorAll<HTMLHeadingElement>('h1[id], h2[id], h3[id], h4[id]').forEach((heading) => {
		if (heading.querySelector('.heading-anchor')) return;
		const anchor = document.createElement('a');
		anchor.className = 'heading-anchor';
		anchor.href = `#${heading.id}`;
		anchor.textContent = '#';
		anchor.setAttribute('aria-label', `链接到“${heading.textContent ?? ''}”`);
		heading.append(anchor);
	});

	article?.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
		if (pre.querySelector('.copy-code')) return;
		const button = document.createElement('button');
		button.className = 'copy-code';
		button.type = 'button';
		button.textContent = '复制';
		button.setAttribute('aria-label', '复制代码');
		button.addEventListener('click', async () => {
			const code = pre.querySelector('code')?.textContent ?? '';
			await navigator.clipboard.writeText(code);
			button.textContent = '已复制';
			window.setTimeout(() => { button.textContent = '复制'; }, 1600);
		});
		pre.append(button);
	});

	article?.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
		if (!image.hasAttribute('loading')) image.loading = 'lazy';
		image.decoding = 'async';
	});

	document.querySelector<HTMLButtonElement>('.copy-link')?.addEventListener('click', async (event) => {
		const button = event.currentTarget as HTMLButtonElement;
		await navigator.clipboard.writeText(button.dataset.url ?? window.location.href);
		button.textContent = '已复制';
		window.setTimeout(() => { button.textContent = '复制链接'; }, 1600);
	});

	const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
	const observedHeadings = tocLinks
		.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
		.filter((heading): heading is HTMLElement => Boolean(heading));
	if ('IntersectionObserver' in window && observedHeadings.length > 0) {
		const observer = new IntersectionObserver((entries) => {
			entries.filter((entry) => entry.isIntersecting).forEach((entry) => {
				tocLinks.forEach((link) => link.classList.toggle('active', link.hash === `#${entry.target.id}`));
			});
		}, { rootMargin: '-15% 0px -75% 0px' });
		observedHeadings.forEach((heading) => observer.observe(heading));
	}
</script>

<style>
	.post-grid { display: grid; grid-template-columns: minmax(0, var(--content-width)) 12rem; gap: 5rem; justify-content: center; width: min(100% - 3rem, 1220px); margin-inline: auto; padding-top: clamp(3.5rem, 8vw, 6rem); }
	.post-article { min-width: 0; }
	.post-header { margin-bottom: 3.5rem; }
	.back-link { display: inline-block; margin-bottom: 2.2rem; color: var(--text-subtle); font-size: 0.82rem; text-decoration: none; }
	.back-link:hover { color: var(--accent); }
	.post-header h1 { margin: 0; font-size: clamp(2.15rem, 6vw, 3.65rem); font-weight: 720; letter-spacing: -0.045em; line-height: 1.18; }
	.post-lead { max-width: 42rem; margin: 1.25rem 0 0; color: var(--text-muted); font-size: 1.03rem; line-height: 1.8; }
	.post-meta { display: flex; flex-wrap: wrap; gap: 0.55rem 1.1rem; margin-top: 1.4rem; color: var(--text-subtle); font-size: 0.78rem; font-variant-numeric: tabular-nums; }
	.post-tags { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.85rem 0 0; padding: 0; list-style: none; }
	.post-tags a { color: var(--accent); font-size: 0.78rem; text-decoration: none; }
	.hero-image { margin: 0 0 3.5rem; }
	.hero-image :global(img) { width: 100%; border-radius: 0.6rem; }
	.toc { position: sticky; top: 2rem; align-self: start; max-height: calc(100vh - 4rem); margin-top: 11rem; overflow: auto; }
	.toc > p { margin: 0 0 0.7rem; color: var(--text); font-size: 0.78rem; font-weight: 650; letter-spacing: 0.08em; }
	.toc nav { display: flex; flex-direction: column; gap: 0.25rem; border-left: 1px solid var(--border); }
	.toc a { padding: 0.22rem 0 0.22rem 0.8rem; color: var(--text-subtle); font-size: 0.74rem; line-height: 1.5; text-decoration: none; transition: color 150ms ease, border-color 150ms ease; }
	.toc a:hover, .toc a.active { color: var(--accent-strong); }
	.toc .depth-3 { padding-left: 1.25rem; }
	.toc .depth-4 { padding-left: 1.7rem; }

	.article-content { color: var(--text); font-size: 1rem; line-height: 1.95; overflow-wrap: break-word; }
	.article-content :global(h1), .article-content :global(h2), .article-content :global(h3), .article-content :global(h4) { position: relative; scroll-margin-top: 2rem; color: var(--text); font-weight: 680; line-height: 1.4; }
	.article-content :global(h1) { margin: 3.4rem 0 1.2rem; font-size: 2rem; }
	.article-content :global(h2) { margin: 3.2rem 0 1.1rem; padding-bottom: 0.55rem; border-bottom: 1px solid var(--border); font-size: 1.65rem; }
	.article-content :global(h3) { margin: 2.5rem 0 0.9rem; font-size: 1.3rem; }
	.article-content :global(h4) { margin: 2rem 0 0.75rem; font-size: 1.08rem; }
	.article-content :global(.heading-anchor) { margin-left: 0.45rem; color: var(--border-strong); font-weight: 400; text-decoration: none; opacity: 0; transition: opacity 150ms ease, color 150ms ease; }
	.article-content :global(h1:hover .heading-anchor), .article-content :global(h2:hover .heading-anchor), .article-content :global(h3:hover .heading-anchor), .article-content :global(h4:hover .heading-anchor), .article-content :global(.heading-anchor:focus) { color: var(--accent); opacity: 1; }
	.article-content :global(p) { margin: 1.2rem 0; }
	.article-content :global(ul), .article-content :global(ol) { margin: 1.2rem 0; padding-left: 1.45rem; }
	.article-content :global(li) { margin: 0.35rem 0; padding-left: 0.25rem; }
	.article-content :global(blockquote) { margin: 1.8rem 0; padding: 0.15rem 0 0.15rem 1.2rem; border-left: 3px solid var(--accent); color: var(--text-muted); font-size: 1.02rem; }
	.article-content :global(blockquote p) { margin: 0.55rem 0; }
	.article-content :global(hr) { margin: 3rem 0; border: 0; border-top: 1px solid var(--border); }
	.article-content :global(a) { text-decoration-thickness: 1px; }
	.article-content :global(code) { padding: 0.16em 0.38em; border: 1px solid var(--border); border-radius: 0.3rem; background: var(--surface-subtle); color: var(--accent-strong); font-family: var(--font-mono); font-size: 0.86em; }
	.article-content :global(pre) { position: relative; margin: 1.75rem 0; padding: 1.25rem 1.35rem; overflow-x: auto; border: 1px solid var(--border); border-radius: 0.55rem; background: var(--code-bg) !important; color: var(--code-text); line-height: 1.65; tab-size: 2; }
	.article-content :global(pre code) { padding: 0; border: 0; background: transparent; color: inherit; font-size: 0.82rem; }
	.article-content :global(.copy-code) { position: absolute; top: 0.65rem; right: 0.65rem; padding: 0.28rem 0.55rem; border: 1px solid #4c535d; border-radius: 0.3rem; background: #292f36; color: #cbd0d7; font-size: 0.7rem; cursor: pointer; }
	.article-content :global(.copy-code:hover) { border-color: #79838f; color: #fff; }
	.article-content :global(table) { display: block; width: 100%; margin: 1.75rem 0; overflow-x: auto; border-collapse: collapse; font-size: 0.9rem; }
	.article-content :global(th), .article-content :global(td) { padding: 0.7rem 0.85rem; border: 1px solid var(--border); text-align: left; }
	.article-content :global(th) { background: var(--surface-subtle); font-weight: 650; }
	.article-content :global(figure) { margin: 2.2rem 0; }
	.article-content :global(figure img), .article-content :global(p > img) { width: 100%; border: 1px solid var(--border); border-radius: 0.55rem; }
	.article-content :global(figcaption) { margin-top: 0.65rem; color: var(--text-subtle); font-size: 0.78rem; text-align: center; }

	.post-footer { margin-top: 4.5rem; }
	.share-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; padding: 1.1rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); color: var(--text-subtle); font-size: 0.8rem; }
	.share-row > span { margin-right: auto; color: var(--text-muted); }
	.share-row a, .share-row button { padding: 0; border: 0; background: none; color: var(--text-subtle); font: inherit; text-decoration: none; cursor: pointer; }
	.share-row a:hover, .share-row button:hover { color: var(--accent); }
	.post-navigation { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.2rem; }
	.post-navigation a { display: flex; flex-direction: column; gap: 0.25rem; color: var(--text); text-decoration: none; }
	.post-navigation a:hover strong { color: var(--accent); }
	.post-navigation span { color: var(--text-subtle); font-size: 0.74rem; }
	.post-navigation strong { font-size: 0.92rem; font-weight: 550; line-height: 1.55; transition: color 150ms ease; }
	.post-navigation .next { text-align: right; }

	@media (max-width: 1050px) { .post-grid { grid-template-columns: minmax(0, var(--content-width)); width: min(100% - 2.5rem, var(--content-width)); } .toc { display: none; } }
	@media (max-width: 640px) { .post-grid { width: min(100% - 1.5rem, var(--content-width)); padding-top: 3rem; } .post-header { margin-bottom: 2.5rem; } .post-header h1 { font-size: 2.1rem; } .article-content { line-height: 1.88; } .post-navigation { grid-template-columns: 1fr; } .post-navigation .next { text-align: left; } }
</style>
